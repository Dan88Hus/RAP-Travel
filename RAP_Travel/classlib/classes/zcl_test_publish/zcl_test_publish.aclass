CLASS zcl_test_publish DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun .
  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.



CLASS zcl_test_publish IMPLEMENTATION.


  METHOD if_oo_adt_classrun~main.
    DATA(lo_client) = cl_web_http_client_manager=>create_by_http_destination(
    cl_http_destination_provider=>create_by_url(
      'https://87073b08-232b-42f9-ae7c-bc59cf2ae025.abap.us10.hana.ondemand.com'
    )
  ).
  out->write( 'Connection OK' ).
  ENDMETHOD.
ENDCLASS.